# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Empty -> analytics + cookie banner off.
VITE_GA_ID=G-CDDW7Z5S9F

# Web3Forms access key for the contact form (public by design, ends up in the client bundle).
VITE_WEB3FORMS_KEY=5d4f4c6c-7bb6-4c60-b567-069809a4f1c9

# Assets source: `internal` (src/assets) or `external` (ASSETS_DIR). Build-time only, not bundled.
ASSETS_SOURCE=internal
# External assets dir (same layout as src/assets, incl. altText.ts); relative to project root or absolute.
ASSETS_DIR=./src/assets_external
